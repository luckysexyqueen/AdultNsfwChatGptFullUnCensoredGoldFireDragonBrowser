    {"id":"cloudflare-pages","role":"static_host","supports_backend":false,"integration":["static_assets","git_repository"]},
    {"id":"cloudflare-workers","role":"serverless_backend","supports_backend":true,"integration":["worker_source","routes","bindings_manifest"]},
    {"id":"onspace-ai","role":"external_ai_builder","integration":["user_exported_zip","source_files"]},
    {"id":"readdy-ai","role":"external_ai_builder","integration":["user_exported_zip","source_files"]},
    {"id":"manus","role":"external_ai_builder","integration":["user_exported_zip","source_files"]},
    {"id":"chatgpt","role":"assistant_and_plugin","integration":["user_uploaded_files","explicit_plugin_actions"]},
    {"id":"codex","role":"coding_agent","integration":["git_diff","source_files","user_exported_zip"]},
